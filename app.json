{
  "expo": {
    "name": "The System",
    "slug": "the-system",
    "version": "1.6.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.edwardapps.thesystem",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#01040A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "The System uses the camera so you can take a photo as proof of a quest.",
          "photosPermission": "The System opens your photos so you can pick a screenshot (like Strava) as proof of a quest.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "The System uses your location while the app is open: to fit quests to where you are, to check the weather, and to confirm you're at the place a troll quest asks for."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "The System reads your calendar (never changes it) so quests and reminders plan around your appointments."
        }
      ]
    ],
    "scheme": "thesystem",
    "backgroundColor": "#07090d",
    "experiments": {
      "baseUrl": "/The-system"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8615b925-7af6-44be-83f5-714fad1b7d66"
      }
    },
    "owner": "edwoar",
    "updates": {
      "url": "https://u.expo.dev/8615b925-7af6-44be-83f5-714fad1b7d66"
    }
  }
}
