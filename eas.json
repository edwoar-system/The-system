{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "resourceClass": "default"
      }
    },
    "production": {
      "channel": "preview",
      "autoIncrement": true,
      "distribution": "store"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6839325471",
        "ascApiKeyPath": "./asc_api_key.p8",
        "ascApiKeyIssuerId": "FILL_IN_ISSUER_ID",
        "ascApiKeyId": "FILL_IN_KEY_ID"
      }
    }
  }
}
