rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each player can only read and write their own document and everything under it (like the quest log).
    match /players/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /players/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Friend codes: anyone signed in can look one up; you can only claim or change your own.
    match /codes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Tips and ideas: anyone signed in can send one (their own uid, under 1,000 characters). Nobody reads them in the app.
    match /feedback/{id} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
    }

    // Party quests: members and invited friends can read one. Members change only their own progress
    // and claim; an invited friend can only join (adding themselves) or decline.
    match /parties/{id} {
      allow read: if request.auth != null && (request.auth.uid in resource.data.members || request.auth.uid in resource.data.invited);
      allow create: if request.auth != null && request.resource.data.leader == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.invited.size() >= 1 && request.resource.data.invited.size() <= 4;
      allow update: if request.auth != null && (
        (request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["progress", "claimed"])
          && request.resource.data.progress.diff(resource.data.progress).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.claimed.diff(resource.data.claimed).affectedKeys().hasOnly([request.auth.uid]))
        || (request.auth.uid in resource.data.invited
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["members", "invited", "names"])
          && !(request.auth.uid in request.resource.data.invited)
          && request.resource.data.members.size() <= 5
          && (request.resource.data.members == resource.data.members
            || request.resource.data.members == resource.data.members.concat([request.auth.uid])))
      );
      allow delete: if request.auth != null && resource.data.leader == request.auth.uid;
    }

    function signedIn() { return request.auth != null; }
    function isFriend(uid) {
      return exists(/databases/$(database)/documents/public/$(uid)/friends/$(request.auth.uid));
    }
    function hasRequest(to, from) {
      return exists(/databases/$(database)/documents/public/$(to)/requests/$(from));
    }

    // Your public card: only you write it; you and your friends read it.
    match /public/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isFriend(uid));
      allow write: if signedIn() && request.auth.uid == uid;

      // A friend request to {uid} from {from}: only the sender creates it; either side can see or remove it.
      match /requests/{from} {
        allow read, delete: if signedIn() && (request.auth.uid == uid || request.auth.uid == from);
        allow create, update: if signedIn() && request.auth.uid == from && from != uid;
      }

      // Troll quests to {uid}: friends send them (paying 5, 15 or 30 coins); only {uid} can mark one done.
      match /trolls/{id} {
        allow create: if signedIn() && request.resource.data.from == request.auth.uid
          && request.resource.data.cost in [5, 15, 30] && request.resource.data.status == "new"
          && exists(/databases/$(database)/documents/public/$(uid)/friends/$(request.auth.uid));
        allow read: if signedIn() && (request.auth.uid == uid || resource == null || resource.data.from == request.auth.uid);
        allow update: if signedIn() && request.auth.uid == uid && request.resource.data.status == "done";
      }

      // {fid} is a friend of {uid}. Written when {uid} or {fid} accepts the other's request.
      match /friends/{fid} {
        allow read: if signedIn() && (request.auth.uid == uid || request.auth.uid == fid);
        allow create, update: if signedIn() && (
          (request.auth.uid == uid && hasRequest(uid, fid)) ||
          (request.auth.uid == fid && hasRequest(fid, uid))
        );
        allow delete: if signedIn() && (request.auth.uid == uid || request.auth.uid == fid);
      }
    }
  }
}
